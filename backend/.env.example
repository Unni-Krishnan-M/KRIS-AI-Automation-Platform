# Copy to backend/.env and fill in. Never commit the real .env.

# ── App ──────────────────────────────────────────────────
APP_NAME=KRIS
APP_ENV=development           # development | staging | production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ── Database (async driver) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://kris:CHANGE_ME@localhost:5432/kris
# Sync URL for Alembic migrations (offline/sync ops)
DATABASE_SYNC_URL=postgresql+psycopg2://kris:CHANGE_ME@localhost:5432/kris

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Ollama ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ── Auth (set strong values in real .env) ────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── n8n ──────────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
